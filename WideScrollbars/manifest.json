{
  "manifest_version": 3,
  "name": "つかみやすいスクロールバー",
  "version": "1.2.0",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "このサイトの太いスクロールバーを切り替える" },
  "description": "Google スプレッドシートではマウスが近づくとバーが24pxに広がります。一般サイトは標準の約2倍。サイト別に切り替えできます。",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["site.js", "state.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "css": ["sheets.css"],
      "js": ["sheets.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["standard.js"],
      "css": ["standard.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
