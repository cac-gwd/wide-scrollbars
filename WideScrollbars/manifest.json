{
  "manifest_version": 3,
  "name": "つかみやすいスクロールバー",
  "version": "1.3.1",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "スクロールバーの設定", "default_popup": "popup.html" },
  "description": "スクロールバーをつかみやすく。近づくと拡大・常に拡大を選択でき、サイト別オン・オフも保存できます。",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["site.js", "state.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "css": ["sheets.css"],
      "js": ["proximity.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["standard.js", "proximity.js"],
      "css": ["standard.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
